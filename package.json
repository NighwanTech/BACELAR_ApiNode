{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Simple NestJS + Prisma + MySQL authentication backend",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:backend": "nest start --watch backend",
    "start:student": "nest start --watch student-service",
    "start:dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,STUDENT\" -c \"cyan,yellow\" \"nest start --watch backend\" \"nest start --watch student-service\"",
    "start:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,STUDENT\" -c \"cyan,yellow\" \"nest start backend\" \"nest start student-service\"",
    "start:prod": "node scripts/start-prod.js",
    "build": "npm run prisma:generate && nest build student-service && nest build backend",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.2.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^8.2.2",
    "jest": "^30.4.2",
    "prisma": "^7.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
