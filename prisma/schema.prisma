  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([deletedAt])
}

model CmsMedia {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  mimeType   String
  size       Int
  storageKey String
  url        String?
  altText    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

// ============================================================
// WORKFLOW
// ============================================================

model Workflow {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  code       String?
  module     String
  entityType String
  definition Json? // nodes and transitions
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([tenantId, code])
  @@index([tenantId, module])
  @@index([deletedAt])
}

model WorkflowInstance {
  id           String         @id @default(uuid())
  tenantId     String
  workflowId   String?
  entityType   String
  entityId     String
  currentState String
  states       Json?
  createdById  String?
  completedAt  DateTime?
  status       WorkflowStatus @default(IN_PROGRESS)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

enum WorkflowStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  PENDING_APPROVAL
}

// ============================================================
// SEARCH INDEX
// ============================================================

model SearchIndex {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  entityId   String
  title      String?
  content    String?
  tags       Json?
  metadata   Json?
  isPublic   Boolean  @default(false)
  indexedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
  @@index([tenantId, isPublic])
}

// ============================================================
// REPORTS & ANALYTICS
// ============================================================

model Report {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  category    String?
  query       Json?
  columns     Json?
  filters     Json?
  schedule    Json?
  isPublic    Boolean   @default(false)
  createdById String?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, category])
  @@index([deletedAt])
}

model DashboardWidget {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  type      String? // chart, table, metric, list
  config    Json?
  dashboard String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

// ============================================================
// AUTHENTICATION / AUTHORIZATION PRIMITIVES
// ============================================================

model Otp {
  id         String    @id @default(uuid())
  tenantId   String?
  identifier String
  purpose    String // login, forgot_password, verify_email, verify_phone, two_factor
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
  @@index([expiresAt])
}
