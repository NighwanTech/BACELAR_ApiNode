// ============================================================
// STUDENT
// ============================================================

model Student {
  id                   String                 @id @default(uuid())
  tenantId             String
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id])
  programId            String?
  program              Program?               @relation(fields: [programId], references: [id])
  batchId              String?
  batch                Batch?                 @relation(fields: [batchId], references: [id])
  admissionApplication AdmissionApplication[] @relation("ApplicationStudent")
  enrollmentNo         String?                @unique
  rollNumber           String?
  registrationNo       String?
  admissionDate        DateTime?
  admissionType        String? // merit, management, sports, nri
  category             String? // general, obc, sc, st, ews
  religion             String?
  nationality          String?                @default("Indian")
  bloodGroup           String?
  aadhaarNumber        String?
  parents              Json?
  localGuardian        Json?
  status               StudentStatus          @default(ENROLLED)
  metadata             Json?
  enrollments          Enrollment[]
  guardians            Guardian[]
  educationHistory     EducationHistory[]
  certificates         Certificate[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  HostelAllocation     HostelAllocation[]
  TransportAssignment  TransportAssignment[]

  @@index([tenantId, status])
  @@index([tenantId, programId])
  @@index([deletedAt])
}

enum StudentStatus {
  APPLIED
  ENROLLED
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  EXPELED
  ALUMNI
  PROBATION
}

model Guardian {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  name       String
  relation   String // father, mother, guardian
  occupation String?
  email      String?
  phone      String?
  address    Json?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
}

model EducationHistory {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id])
  degree        String
  institution   String
  board         String?
  yearOfPassing Int
  percentage    Float?
  grade         String?
  subjects      Json?
  documents     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
}

model Enrollment {
  id          String           @id @default(uuid())
  tenantId    String
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id])
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  grade       String?
  marks       Float?
  results     Result[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, courseId])
  @@index([tenantId, status])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  INCOMPLETE
  WAITLISTED
}

// ============================================================
