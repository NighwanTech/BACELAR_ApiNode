  publishedById String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, examinationId])
}

enum ResultStatus {
  PENDING
  PASS
  FAIL
  SUPPLEMENTARY
  COMPARTMENT
  DISTINCTION
  AWAITING
  PUBLISHED
}

model GradeScale {
  id        String    @id @default(uuid())
  tenantId  String
