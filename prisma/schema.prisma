  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model Certificate {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
