  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([examinationId])
}

model Result {
  id            String       @id @default(uuid())
  tenantId      String
  examinationId String
  examination   Examination  @relation(fields: [examinationId], references: [id])
