// ============================================================
// UniversityOS - Prisma Schema
// Enterprise ERP + LMS Platform for Indian Higher Education
// UUID PKs, Soft Delete, Audit Columns, Multi-Tenant
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM - TENANT
// ============================================================

model Tenant {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  type         TenantType
  status       TenantStatus @default(ACTIVE)
  domain       String?      @unique
  email        String?
  phone        String?
  address      Json?
  logo         String?
  favicon      String?
  theme        Json? // branding/theme config
  config       Json? // tenant-level configuration
  timezone     String       @default("Asia/Kolkata")
  locale       String       @default("en-IN")
  academicYear String?
  features     Json? // feature flags snapshot

  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  institutions         Institution[]
  campuses             Campus[]
  users                User[]
  roles                Role[]
  permissions          Permission[]
  featureFlags         FeatureFlag[]
  documents            Document[]
  media                Media[]
  auditLogs            AuditLog[]
  domains              TenantDomain[]
  workflows            Workflow[]
  notifications        Notification[]
  apiKeys              ApiKey[]
  sessions             Session[]
  courses              Course[]
  programs             Program[]
  departments          Department[]
  semesters            Semester[]
  subjects             Subject[]
  NotificationTemplate NotificationTemplate[]

  @@index([code])
  @@index([status])
  @@index([deletedAt])
}

enum TenantType {
  UNIVERSITY
  COLLEGE
  B_ED
  D_EL_ED
  ENGINEERING
  MEDICAL
  PHARMACY
  NURSING
  LAW
  POLYTECHNIC
  ITI
  AUTONOMOUS
  INSTITUTE
  SCHOOL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  PENDING
  ARCHIVED
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  domain    String   @unique
  isPrimary Boolean  @default(false)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================
// PLATFORM - IDENTITY & ACCESS
// ============================================================

model User {
  id                String     @id @default(uuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  email             String
  phone             String?
  passwordHash      String?
  firstName         String
  lastName          String
  middleName        String?
  avatarUrl         String?
  gender            String?
  dateOfBirth       DateTime?
  status            UserStatus @default(ACTIVE)
  type              UserType   @default(STAFF)
  twoFactorEnabled  Boolean    @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  locale            String?    @default("en-IN")
  timezone          String?    @default("Asia/Kolkata")
  metadata          Json?

  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  roles             UserRole[]
  sessions          Session[]
  refreshTokens     RefreshToken[]
  apiKeys           ApiKey[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  students          Student[]
  faculties         Faculty[]
  documents         Document[]
  media             Media[]
  permissions       UserPermission[]
  devices           Device[]
  addresses         Address[]
  emergencyContacts EmergencyContact[]
  guardian          Guardian[]
  educationHistory  EducationHistory[]
  certificates      Certificate[]
  issuedDocuments   DocumentIssue[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([email])
  @@index([deletedAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  PENDING
  DELETED
}

enum UserType {
  SUPER_ADMIN
  ADMIN
  STAFF
  FACULTY
  STUDENT
  GUARDIAN
  ALUMNI
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  slug        String
  description String?
  isSystem    Boolean @default(false)
  status      Status  @default(ACTIVE)

  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([deletedAt])
}

model Permission {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  slug        String
  module      String
  description String?
  action      String // create, read, update, delete, manage
  resource    String // student, faculty, course, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([tenantId, slug])
  @@index([tenantId, module])
  @@index([deletedAt])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

model Session {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  tokenId        String        @unique
  refreshTokenId String?       @unique
  userAgent      String?
  ipAddress      String?
  deviceId       String?
  device         Device?       @relation(fields: [deviceId], references: [id])
  status         SessionStatus @default(ACTIVE)
  expiresAt      DateTime
  lastActiveAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  revokedAt      DateTime?

  @@index([tenantId, userId])
  @@index([status])
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  TERMINATED
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  sessionId  String?
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  sessions    Session[]
  name        String
  type        String // mobile, tablet, desktop
  platform    String? // ios, android, windows, macos, linux
  browser     String?
  model       String?
  fingerprint String?
  isTrusted   Boolean   @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     Json?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  status     Status    @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String // PERMANENT, CURRENT, LOCAL, PARENTAL
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  relation  String
  phone     String
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// PLATFORM - FEATURE MANAGEMENT
// ============================================================

model FeatureFlag {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  key         String
  name        String
  module      String
  description String?
  enabled     Boolean   @default(true)
  config      Json?
  isPremium   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([tenantId, key])
  @@index([tenantId, module])
  @@index([deletedAt])
}

model Module {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  version     String    @default("1.0.0")
  status      Status    @default(ACTIVE)
  order       Int       @default(0)
  config      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

// ============================================================
// PLATFORM - AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  module     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, module])
  @@index([tenantId, userId])
  @@index([tenantId, resource, resourceId])
  @@index([createdAt])
}

// ============================================================
// PLATFORM - NOTIFICATIONS
// ============================================================

model Notification {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?              @relation(fields: [userId], references: [id])
  type      String // email, sms, push, in_app
  channel   String
  subject   String?
  body      String?
  template  String?
  data      Json?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, type])
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

model NotificationTemplate {
  id        String    @id @default(uuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  code      String
  channel   String
  subject   String?
  body      String
  variables Json?
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, code, channel])
  @@index([deletedAt])
}

// ============================================================
// PLATFORM - DOCUMENTS & MEDIA
// ============================================================

model Document {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  uploadedById     String?
  uploadedBy       User?              @relation(fields: [uploadedById], references: [id])
  name             String
  description      String?
  category         String? // certificate, id_card, transcript, marksheet
  mimeType         String
  extension        String
  size             Int
  storageKey       String
  checksum         String?
  metadata         Json?
  status           DocumentStatus     @default(UPLOADED)
  version          Int                @default(1)
  digitalSignature String?
  qrCode           String?
  isPublic         Boolean            @default(false)
  expiresAt        DateTime?
  signedById       String?
  signedAt         DateTime?
  approvals        DocumentApproval[]
  versions         DocumentVersion[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([deletedAt])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  VERIFIED
  SIGNED
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  version     Int
  storageKey  String
  size        Int
  checksum    String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
}

model DocumentApproval {
  id           String         @id @default(uuid())
  documentId   String
  document     Document       @relation(fields: [documentId], references: [id])
  approverId   String?
  approverName String
  sequence     Int
  status       ApprovalStatus @default(PENDING)
  comment      String?
  signedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([documentId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  WITHDRAWN
}

model Media {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])
  name         String
  mimeType     String
  size         Int
  storageKey   String
  url          String?
  width        Int?
  height       Int?
  duration     Int?
  altText      String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model DocumentIssue {
  id          String    @id @default(uuid())
  tenantId    String
  documentId  String
  issuedToId  String
  issuedTo    User      @relation(fields: [issuedToId], references: [id])
  issueNumber String    @unique
  issuedAt    DateTime  @default(now())
  issuedById  String?
  purpose     String?
  validUntil  DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([tenantId, issuedToId])
  @@index([documentId])
}

// ============================================================
// ACADEMIC
// ============================================================

model Institution {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  name            String
  code            String?
  type            String?
  affiliatedTo    String?
  establishedYear Int?
  address         Json?
  contact         Json?
  accreditation   Json?
  status          Status    @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  programs    Program[]
  departments Department[]
  campuses    Campus[]

  @@index([tenantId])
  @@index([deletedAt])
}

model Campus {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  name          String
  code          String?
  address       Json?
  contact       Json?
  status        Status       @default(ACTIVE)
  departments   Department[]
  programs      Program[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model Department {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  institutionId      String?
  institution        Institution? @relation(fields: [institutionId], references: [id])
  campusId           String?
  campus             Campus?      @relation(fields: [campusId], references: [id])
  name               String
  code               String?
  headOfDepartmentId String?
  description        String?
  status             Status       @default(ACTIVE)
  programs           Program[]
  faculties          Faculty[]
  subjects           Subject[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  CLOSED
  ARCHIVED
}

model Program {
  id                   String                 @id @default(uuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  institutionId        String?
  institution          Institution?           @relation(fields: [institutionId], references: [id])
  campusId             String?
  campus               Campus?                @relation(fields: [campusId], references: [id])
  departmentId         String?
  department           Department?            @relation(fields: [departmentId], references: [id])
  name                 String
  code                 String?
  level                String // UG, PG, Diploma, Certificate, Doctorate
  durationYears        Int?
  durationSemesters    Int?
  degree               String?
  specialization       String?
  eligibility          Json?
  fees                 Json?
  intakeCapacity       Int?
  affiliation          Json?
  status               Status                 @default(ACTIVE)
  courses              Course[]
  batches              Batch[]
  semesters            Semester[]
  students             Student[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  AdmissionApplication AdmissionApplication[]

  @@index([tenantId])
  @@index([deletedAt])
}

model Semester {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  programId   String?
  program     Program?      @relation(fields: [programId], references: [id])
  name        String
  code        String?
  number      Int
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean       @default(false)
  status      Status        @default(ACTIVE)
  courses     Course[]
  batches     Batch[]
  subjects    Subject[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  Examination Examination[]

  @@index([tenantId, programId])
  @@index([deletedAt])
}

model Course {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  programId          String?
  program            Program?        @relation(fields: [programId], references: [id])
  semesterId         String?
  semester           Semester?       @relation(fields: [semesterId], references: [id])
  code               String
  name               String
  description        String?
  credits            Int?
  courseType         String? // CORE, ELECTIVE, LAB, PROJECT
  lectureHours       Int?
  tutorialHours      Int?
  practicalHours     Int?
  syllabus           Json?
  status             Status          @default(ACTIVE)
  subjects           Subject[]
  facultyAssignments FacultyCourse[]
  enrollments        Enrollment[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  Examination        Examination[]
  LmsCourse          LmsCourse[]

  @@unique([tenantId, code])
  @@index([tenantId, programId])
  @@index([deletedAt])
}

model Subject {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  courseId      String?
  course        Course?        @relation(fields: [courseId], references: [id])
  semesterId    String?
  semester      Semester?      @relation(fields: [semesterId], references: [id])
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  code          String
  name          String
  credits       Int?
  subjectType   String? // THEORY, PRACTICAL, PROJECT, VIVA
  internalMarks Int?
  externalMarks Int?
  passMarks     Int?
  totalMarks    Int?
  status        Status         @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  ExamSchedule  ExamSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId, courseId])
  @@index([deletedAt])
}

model Batch {
  id           String    @id @default(uuid())
  tenantId     String
  programId    String?
  program      Program?  @relation(fields: [programId], references: [id])
  semesterId   String?
  semester     Semester? @relation(fields: [semesterId], references: [id])
  name         String
  academicYear String
  startDate    DateTime?
  endDate      DateTime?
  status       Status    @default(ACTIVE)
  students     Student[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId, programId])
  @@index([deletedAt])
}

// ============================================================
// ADMISSION
// ============================================================

model AdmissionApplication {
  id                  String              @id @default(uuid())
  tenantId            String
  programId           String?
  program             Program?            @relation(fields: [programId], references: [id])
  applicationNo       String              @unique
  applicantName       String
  email               String
  phone               String
  dateOfBirth         DateTime?
  gender              String?
  category            String?
  fatherName          String?
  motherName          String?
  address             Json?
  photo               String?
  documents           Json?
  academicDetails     Json?
  entranceScore       Float?
  meritScore          Float?
  status              ApplicationStatus   @default(SUBMITTED)
  currentStage        String?
  submittedAt         DateTime?
  reviewedById        String?
  remarks             String?
  metadata            Json?
  enrolledStudentId   String?
  student             Student?            @relation("ApplicationStudent", fields: [enrolledStudentId], references: [id])
  timeline            AdmissionTimeline[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  AdmissionSchedule   AdmissionSchedule?  @relation(fields: [admissionScheduleId], references: [id])
  admissionScheduleId String?

  @@index([tenantId, status])
  @@index([tenantId, programId])
  @@index([email])
  @@index([deletedAt])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  CALLED_FOR_INTERVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WAITLISTED
  ENROLLED
  CANCELLED
}

model AdmissionTimeline {
  id            String               @id @default(uuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id])
  stage         String
  status        ApplicationStatus
  comment       String?
  performedById String?
  createdAt     DateTime             @default(now())

  @@index([applicationId])
}

model AdmissionSchedule {
  id           String                 @id @default(uuid())
  tenantId     String
  programId    String?
  name         String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  eligibility  Json?
  fees         Json?
  status       Status                 @default(ACTIVE)
  applications AdmissionApplication[]
