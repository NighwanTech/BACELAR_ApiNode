  student      Student            @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  enrollmentId Int?
  enrollment   StudentEnrollment? @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: SetNull)

  registrationNo String? @db.VarChar(100)
  enrollmentNo   String  @unique @db.VarChar(100)
  rollNo         String? @db.VarChar(100)

  studentName String?   @db.VarChar(255)
  fatherName  String?   @db.VarChar(255)
  motherName  String?   @db.VarChar(255)
  dateOfBirth DateTime?
  gender      String?   @db.VarChar(20)
  category    String?   @db.VarChar(50)
  emailId     String?   @db.VarChar(255)
  mobileNo    String?   @db.VarChar(20)
  address     String?   @db.Text

  password      String  @db.VarChar(255)
  plainPassword String? @db.VarChar(100)
