model StudentExam {
  studentExamId Int     @id @default(autoincrement())
  studentId     Int
  student       Student @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)

  registrationNo   String?   @db.VarChar(100)
  enrollmentNo     String?   @db.VarChar(100)
  studentNameEng   String?   @db.VarChar(255)
  studentNameHindi String?   @db.VarChar(255)
  fatherName       String?   @db.VarChar(255)
  motherName       String?   @db.VarChar(255)
  dob              DateTime?
  mobileNo         String?   @db.VarChar(20)
  emailId          String?   @db.VarChar(255)
  rollNo           String?   @db.VarChar(100)
  admissionNo      String?   @db.VarChar(100)
  barNo            String?   @db.VarChar(100)
  examFormNo       String?   @db.VarChar(100)
  uniqueNo         String?   @db.VarChar(100)

  examTypeId       Int?
  examTypeRelation ExamTypeMaster? @relation(fields: [examTypeId], references: [examTypeId], onDelete: SetNull)
  examType         String?         @db.VarChar(50)

  courseCategoryId       Int?
  courseCategoryRelation ProgramCategory?  @relation(fields: [courseCategoryId], references: [programCategoryId], onDelete: SetNull)
  courseCategory         String?           @db.VarChar(255)
  courseId               Int?
  course                 Program?          @relation(fields: [courseId], references: [programId], onDelete: SetNull)
  courseShortName        String?           @db.VarChar(255)
  yearId                 Int?
  year                   YearMaster?       @relation(fields: [yearId], references: [yearId], onDelete: SetNull)
  yearName               String?           @db.VarChar(100)
  semId                  Int?
  semester               SemesterMaster?   @relation(fields: [semId], references: [semId], onDelete: SetNull)
  semName                String?           @db.VarChar(100)
  sessionId              Int?
  session                AdmissionSession? @relation(fields: [sessionId], references: [admissionSessionId], onDelete: SetNull)

  studentImgURL      String? @db.VarChar(2000)
  studentImgName     String? @db.VarChar(255)
  studentSignImgURL  String? @db.VarChar(2000)
  studentSignImgName String? @db.VarChar(255)

  examFeeId        Int?
  examFeeConfig    ProgramFeeConfig? @relation(fields: [examFeeId], references: [feeConfigId], onDelete: SetNull)
  totalExamFee     Float?            @default(0.0)
  isFeePaymentDone Boolean           @default(false)
  totalPaidAmount  Float?            @default(0.0)
  bankTxnNo        String?           @db.VarChar(100)
  bankTxnDetail    String?           @db.Text
  feePaymentDate   DateTime?
  isExamFeePaid    Boolean           @default(false)

  isExamFormFinalSubmit Boolean   @default(false)
  isExamFormPrintTaken  Boolean   @default(false)
  isExamFormSendOnEmail Boolean   @default(false)
  isExamFormVerify      Boolean   @default(false)
  verifyBy              String?   @db.VarChar(255)
  verifyDate            DateTime?
  verificationRemarks   String?   @db.Text
  isReadyForAdmitCard   Boolean   @default(false)

  selectedPaperIds String? @db.VarChar(500)
  examPaymentIds   String? @db.VarChar(500)

  examinationDetailId Int?
  examinationDetail   ExaminationDetails? @relation(fields: [examinationDetailId], references: [examinationId], onDelete: SetNull)
  examinationName     String?             @db.VarChar(100)

  papers StudentExamPaper[]

  Remarks        String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String?   @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)

  @@index([studentId])
  @@index([enrollmentNo])
  @@index([registrationNo])
  @@index([courseId])
  @@index([examFeeId])
  @@index([examTypeId])
  @@index([yearId])
  @@index([semId])
  @@index([sessionId])
  @@index([examinationDetailId])
  @@map("studentExam")
}

model StudentExamPaper {
