generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Student {
  StudentRegistrationId Int                     @id @default(autoincrement())
  candidateName         String                  @db.VarChar(255)
  fatherName            String                  @db.VarChar(255)
  email                 String                  @unique @db.VarChar(255)
  mobileNo              String                  @db.VarChar(20)
  registrationNo        String                  @unique @db.VarChar(100)
  // Selected admission program + auto-assigned active admission session
  programId             Int?
  program               Program?                @relation(fields: [programId], references: [programId])
  admissionSessionId    Int?
  admissionSession      AdmissionSession?       @relation(fields: [admissionSessionId], references: [admissionSessionId])
  // Current college year / semester (register → Year 1 + Sem 1; promote updates these)
  yearId                Int?
  year                  YearMaster?             @relation(fields: [yearId], references: [yearId])
  semId                 Int?
  semester              SemesterMaster?         @relation(fields: [semId], references: [semId])
  /// B.P.Ed. only: student claims recognized sport certificate (eligibility % depends on this)
  hasSportCertificate   Boolean                 @default(false)
  CreatedOn             DateTime                @default(now())
  CreatedBy             String                  @db.VarChar(255)
  UpdatedOn             DateTime?               @updatedAt
  UpdatedBy             String?                 @db.VarChar(255)
  IsActive              Boolean                 @default(true)
  IsDeleted             Boolean                 @default(false)
  DeletedRemarks        String?                 @db.VarChar(255)
  DeletedOn             DateTime?
  DeletedBy             String?                 @db.VarChar(255)
  Remarks               String?                 @db.VarChar(255)
  studentProfile        StudentProfile?
  academicDetails       StudentAcademicDetail[]
  programSubjects       StudentProgramSubject[]
  studentPayments       StudentPayment[]
  studentAttachments    StudentAttachment[]
  studentEnrollments    StudentEnrollment[]
  loginMaster           LoginMaster?
  examLoginMaster       ExamLoginMaster?
  studentExams          StudentExam[]
  studentExamPapers     StudentExamPaper[]
  studentRollNumbers    StudentRollNumber[]

  @@index([yearId])
  @@index([semId])
  @@map("students")
}

model LoginMaster {
  LoginId           Int       @id @default(autoincrement())
  StudentId         Int       @unique
  student           Student   @relation(fields: [StudentId], references: [StudentRegistrationId], onDelete: Cascade)
  RegistrationNo    String    @unique @db.VarChar(100)
  LoginName         String?   @db.VarChar(255)
  Mobile            String?   @db.VarChar(20)
  EmailId           String?   @db.VarChar(255)
  Password          String    @db.VarChar(255)
  PlainPassword     String?   @db.VarChar(50)
  OldPassword       String?   @db.VarChar(255)
  IsPasswordUpdated Boolean   @default(false)
  PasswordChangeOn  DateTime?
  OTP               String?   @db.VarChar(20)
  OTPSendTime       DateTime?
  RoleId            Int       @default(1)
  ClientId          Int?
  ProfilePhoto      String?   @db.VarChar(500)
  LastLogin         DateTime?
  IpAddress         String?   @db.VarChar(100)
  MACAddress        String?   @db.VarChar(100)
  IsActive          Boolean   @default(true)
  CreatedOn         DateTime  @default(now())
  CreatedBy         String?   @db.VarChar(255)
  ModifyOn          DateTime? @updatedAt
  ModifyBy          String?   @db.VarChar(255)
  Remarks           String?   @db.VarChar(255)

  @@index([EmailId])
  @@index([Mobile])
  @@map("loginMaster")
}

model StateMaster {
  stateId        Int       @id @default(autoincrement())
  stateName      String    @unique @db.VarChar(100)
  stateShortCode String    @unique @db.VarChar(10)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("stateMaster")
}

model CityMaster {
  cityId         Int       @id @default(autoincrement())
  stateId        Int
  cityName       String    @unique @db.VarChar(100)
  cityShortCode  String    @unique @db.VarChar(10)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("cityMaster")
}

model ZipcodeMaster {
  zipcodeId      Int       @id @default(autoincrement())
  zipCode        String    @db.VarChar(20)
  stateId        Int
  cityId         Int
  locality       String    @db.VarChar(255)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@index([stateId])
  @@index([cityId])
  @@index([zipCode])
  @@map("zipcodeMaster")
}

model ProgramCategory {
  programCategoryId   Int                    @id @default(autoincrement())
  programCategoryName String                 @db.VarChar(100)
  pcShortName         String                 @db.VarChar(20)
  sequenceNo          Int
  CreatedOn           DateTime               @default(now())
  CreatedBy           String                 @db.VarChar(255)
  UpdatedOn           DateTime?              @updatedAt
  UpdatedBy           String?                @db.VarChar(255)
  IsActive            Boolean                @default(true)
  IsDeleted           Boolean                @default(false)
  DeletedRemarks      String?                @db.VarChar(255)
  DeletedOn           DateTime?
  DeletedBy           String?                @db.VarChar(255)
  Remarks             String?                @db.VarChar(255)
  programs            Program[]
  programSubjects     ProgramSubjectMaster[]
  examSubjects        ExamSubjectMaster[]
  studentExams        StudentExam[]
  examSchemes         ExamScheme[]

  @@map("programCategory")
}

model StudentProfile {
  studentProfileId      Int       @id @default(autoincrement())
  studentId             Int       @unique
  student               Student   @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  studentNameHindi      String?   @db.VarChar(255)
  fatherNameHindi       String?   @db.VarChar(255)
  motherName            String?   @db.VarChar(255)
  motherNameHindi       String?   @db.VarChar(255)
  fatherMobileNumber    String?   @db.VarChar(20)
  dateOfBirth           DateTime?
  gender                String?   @db.VarChar(50)
  maritalStatus         String?   @db.VarChar(50)
  religion              String?   @db.VarChar(100)
  nationality           String?   @db.VarChar(100)
  category              String?   @db.VarChar(100)
  subCategory           String?   @db.VarChar(100)
  physicalHandicap      String?   @db.VarChar(255)
  certificateNo         String?   @db.VarChar(255)
  certificateAttachment String?   @db.VarChar(255)
  aadharIdNo            String?   @db.VarChar(50)
  apaarIdNo             String?   @db.VarChar(50)
  nameAsPerAdhar        String?   @db.VarChar(255)
  dobAsPerAdhar         DateTime?

  // Correspondence Address
  CaddressLine1 String? @db.VarChar(255)
  CaddressLine2 String? @db.VarChar(255)
  CaddressLine3 String? @db.VarChar(255)
  Cstate        String? @db.VarChar(100)
  Ccity         String? @db.VarChar(100)
  Cpincode      String? @db.VarChar(20)

  // Permanent Address
  PaddressLine1 String? @db.VarChar(255)
  PaddressLine2 String? @db.VarChar(255)
  PaddressLine3 String? @db.VarChar(255)
  Pstate        String? @db.VarChar(100)
  Pcity         String? @db.VarChar(100)
  Ppincode      String? @db.VarChar(20)

  // Common Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("studentProfile")
}

model SubjectMaster {
  subjectId        Int                      @id @default(autoincrement())
  subjectName      String                   @db.VarChar(100)
  subjectCode      String                   @db.VarChar(50)
  classType        String                   @db.VarChar(20)
  stream           String?                  @db.VarChar(50) // "SCIENCE", "COMMERCE", "ARTS"
  CreatedOn        DateTime                 @default(now())
  CreatedBy        String                   @db.VarChar(255)
  UpdatedOn        DateTime?                @updatedAt
  UpdatedBy        String?                  @db.VarChar(255)
  IsActive         Boolean                  @default(true)
  IsDeleted        Boolean                  @default(false)
  DeletedRemarks   String?                  @db.VarChar(255)
  DeletedOn        DateTime?
  DeletedBy        String?                  @db.VarChar(255)
  Remarks          String?                  @db.VarChar(255)
  academicSubjects StudentAcademicSubject[]

  @@map("subjectMaster")
}

model Program {
  programId          Int                    @id @default(autoincrement())
  programCategoryId  Int
  programCategory    ProgramCategory        @relation(fields: [programCategoryId], references: [programCategoryId], onDelete: Cascade)
  programName        String                 @db.VarChar(100)
  programShortName   String                 @db.VarChar(20)
  programCode        String                 @db.VarChar(50)
  durationYears      Int
  termType           String                 @db.VarChar(50) // "SEMESTER" or "ANNUAL"
  totalTerms         Int
  sequenceNo         Int
  feeConfigs         ProgramFeeConfig[]
  students           Student[]
  studentEnrollments StudentEnrollment[]
  eligibilityRules   ProgramEligibility[]
  streams            StreamMaster[]
  programSubjects    ProgramSubjectMaster[]
  studentRollNumbers StudentRollNumber[]

  // Common Audit Fields
  CreatedOn          DateTime            @default(now())
  CreatedBy          String              @db.VarChar(255)
  UpdatedOn          DateTime?           @updatedAt
  UpdatedBy          String?             @db.VarChar(255)
  IsActive           Boolean             @default(true)
  IsDeleted          Boolean             @default(false)
  DeletedRemarks     String?             @db.VarChar(255)
  DeletedOn          DateTime?
  DeletedBy          String?             @db.VarChar(255)
  Remarks            String?             @db.VarChar(255)
  paperDetailMasters PaperDetailMaster[]
  examSubjects       ExamSubjectMaster[]
  studentExams       StudentExam[]
  examSchemes        ExamScheme[]

  @@map("programs")
}

model StreamMaster {
  streamId       Int       @id @default(autoincrement())
  programId      Int
  program        Program   @relation(fields: [programId], references: [programId], onDelete: Cascade)
  streamName     String    @db.VarChar(100)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@index([programId])
  @@map("streamMaster")
}

model ProgramSubjectMaster {
  programSubjectId       Int                     @id @default(autoincrement())
  programId              Int
  program                Program                 @relation(fields: [programId], references: [programId], onDelete: Cascade)
  programName            String?                 @db.VarChar(255)
  programCategoryId      Int?
  programCategory        ProgramCategory?        @relation(fields: [programCategoryId], references: [programCategoryId], onDelete: SetNull)
  programCategoryName    String?                 @db.VarChar(255)
  programSubjectName     String                  @db.VarChar(100)
  studentProgramSubjects StudentProgramSubject[]
  CreatedOn              DateTime                @default(now())
  CreatedBy              String                  @db.VarChar(255)
  UpdatedOn              DateTime?               @updatedAt
  UpdatedBy              String?                 @db.VarChar(255)
  IsActive               Boolean                 @default(true)
  IsDeleted              Boolean                 @default(false)
  DeletedRemarks         String?                 @db.VarChar(255)
  DeletedOn              DateTime?
  DeletedBy              String?                 @db.VarChar(255)
  Remarks                String?                 @db.VarChar(255)

  @@index([programId])
  @@index([programCategoryId])
  @@map("programSubjectMaster")
}

model StudentProgramSubject {
  studentProgramSubjectId Int                  @id @default(autoincrement())
  studentId               Int
  student                 Student              @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  programSubjectId        Int
  programSubject          ProgramSubjectMaster @relation(fields: [programSubjectId], references: [programSubjectId], onDelete: Cascade)
  sequenceNo              Int

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@index([studentId])
  @@index([programSubjectId])
  @@map("studentProgramSubjects")
}

model ProgramEligibility {
  eligibilityId      Int       @id @default(autoincrement())
  programId          Int
  program            Program   @relation(fields: [programId], references: [programId], onDelete: Cascade)
  /// SUBJECT | MIN_PERCENT | STREAM | QUALIFICATION
  ruleType           String    @db.VarChar(30)
  /// 10TH | 12TH | GRAD | PG | ALL
  qualificationLevel String    @db.VarChar(20)
  /// GEN | OBC | SC | ST | MINORITY | GENERAL | RESERVED | ALL
  category           String    @default("ALL") @db.VarChar(30)
  /// e.g. 12MATH, AGGREGATE, SCIENCE, GRADUATION, or OR-list 12BIO|12AGRI
  ruleKey            String?   @db.VarChar(100)
  minPercent         Decimal?  @db.Decimal(5, 2)
  /// Compulsory | Recommended
  severity           String    @default("Compulsory") @db.VarChar(20)
  displayOrder       Int       @default(0)
  message            String    @db.VarChar(500)
  CreatedOn          DateTime  @default(now())
  CreatedBy          String    @db.VarChar(255)
  UpdatedOn          DateTime? @updatedAt
  UpdatedBy          String?   @db.VarChar(255)
  IsActive           Boolean   @default(true)
  IsDeleted          Boolean   @default(false)
  DeletedRemarks     String?   @db.VarChar(255)
  DeletedOn          DateTime?
  DeletedBy          String?   @db.VarChar(255)
  Remarks            String?   @db.VarChar(255)

  @@index([programId])
  @@index([ruleType])
  @@map("programEligibility")
}

model BoardMaster {
  boardId        Int       @id @default(autoincrement())
  boardName      String    @unique @db.VarChar(255)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  academicDetails StudentAcademicDetail[]

  @@map("boardMaster")
}

model FeeTypeMaster {
  feeTypeId      Int       @id @default(autoincrement())
  feeTypeName    String    @unique @db.VarChar(100)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  studentPayments StudentPayment[]

  @@map("feeTypeMaster")
}

model QualificationMaster {
  qualificationId   Int       @id @default(autoincrement())
  qualificationName String    @unique @db.VarChar(100)
  CreatedOn         DateTime  @default(now())
  CreatedBy         String    @db.VarChar(255)
  UpdatedOn         DateTime? @updatedAt
  UpdatedBy         String?   @db.VarChar(255)
  IsActive          Boolean   @default(true)
  IsDeleted         Boolean   @default(false)
  DeletedRemarks    String?   @db.VarChar(255)
  DeletedOn         DateTime?
  DeletedBy         String?   @db.VarChar(255)
  Remarks           String?   @db.VarChar(255)

  academicDetails StudentAcademicDetail[]

  @@map("qualificationMaster")
}

model StudentAcademicDetail {
  academicDetailId Int                      @id @default(autoincrement())
  studentId        Int
  student          Student                  @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  qualificationId  Int
  qualification    QualificationMaster      @relation(fields: [qualificationId], references: [qualificationId])
  boardId          Int
  board            BoardMaster              @relation(fields: [boardId], references: [boardId])
  schoolName       String                   @db.VarChar(255)
  passingYear      Int
  rollNo           String                   @db.VarChar(100)
  resultStatus     String                   @db.VarChar(50)
  marksType        String                   @db.VarChar(20)
  maxMarks         Float
  obtainedMarks    Float
  percentage       Float
  division         String?                  @db.VarChar(50)
  grade            String?                  @db.VarChar(20)
  stream           String?                  @db.VarChar(50) // "SCIENCE", "COMMERCE", "ARTS"
  subjects         StudentAcademicSubject[]
  CreatedOn        DateTime                 @default(now())
  CreatedBy        String                   @db.VarChar(255)
  UpdatedOn        DateTime?                @updatedAt
  UpdatedBy        String?                  @db.VarChar(255)
  IsActive         Boolean                  @default(true)
  IsDeleted        Boolean                  @default(false)
  DeletedRemarks   String?                  @db.VarChar(255)
  DeletedOn        DateTime?
  DeletedBy        String?                  @db.VarChar(255)
  Remarks          String?                  @db.VarChar(255)

  @@map("studentAcademicDetails")
}

model StudentAcademicSubject {
  studentAcademicSubjectId Int                   @id @default(autoincrement())
  academicDetailId         Int
  academicDetail           StudentAcademicDetail @relation(fields: [academicDetailId], references: [academicDetailId], onDelete: Cascade)
  subjectId                Int
  subject                  SubjectMaster         @relation(fields: [subjectId], references: [subjectId])
  maxMarks                 Float
  minMarks                 Float
  obtainedMarks            Float
  grade                    String?               @db.VarChar(20)
  practicalMarks           Float?
  theoryMarks              Float?
  isOptional               Boolean               @default(false)
  CreatedOn                DateTime              @default(now())
  CreatedBy                String                @db.VarChar(255)
  UpdatedOn                DateTime?             @updatedAt
  UpdatedBy                String?               @db.VarChar(255)
  IsActive                 Boolean               @default(true)
  IsDeleted                Boolean               @default(false)
  DeletedRemarks           String?               @db.VarChar(255)
  DeletedOn                DateTime?
  DeletedBy                String?               @db.VarChar(255)
  Remarks                  String?               @db.VarChar(255)

  @@map("studentAcademicSubjects")
}

model AdmissionSession {
  admissionSessionId   Int                 @id @default(autoincrement())
  admissionSessionName String              @unique @db.VarChar(50)
  feeConfigs           ProgramFeeConfig[]
  students             Student[]
  studentEnrollments   StudentEnrollment[]
  studentExams         StudentExam[]
  studentRollNumbers   StudentRollNumber[]

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("admissionSessions")
}

model ProgramFeeConfig {
  feeConfigId        Int              @id @default(autoincrement())
  programId          Int
  program            Program          @relation(fields: [programId], references: [programId], onDelete: Cascade)
  admissionSessionId Int
  admissionSession   AdmissionSession @relation(fields: [admissionSessionId], references: [admissionSessionId], onDelete: Cascade)

  registrationBaseFee Float @default(0.0)
  registrationPgRate  Float @default(2.0)
  registrationGstRate Float @default(18.0)
  registrationFinal   Float @default(0.0)

  examinationBaseFee Float @default(0.0)
  examinationPgRate  Float @default(2.0)
  examinationGstRate Float @default(18.0)
  examinationFinal   Float @default(0.0)

  backPaperBaseFee Float @default(0.0)
  backPaperPgRate  Float @default(2.0)
  backPaperGstRate Float @default(18.0)
  backPaperFinal   Float @default(0.0)

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  studentExams StudentExam[]

  @@unique([programId, admissionSessionId])
  @@map("programFeeConfigs")
}

model StudentPayment {
  paymentId Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)

  // Student snapshot (copied from student / profile at payment time)
  registrationNo String?         @db.VarChar(100)
  enrollNo       String?         @db.VarChar(100)
  studentName    String?         @db.VarChar(255)
  fatherName     String?         @db.VarChar(255)
  studentEmail   String?         @db.VarChar(255)
  contactNo      String?         @db.VarChar(20)
  /// Merged correspondence + permanent address (line1/2/3, city, state, pincode)
  addresses      String?         @db.Text
  yearId         Int?
  year           YearMaster?     @relation(fields: [yearId], references: [yearId], onDelete: SetNull)
  semesterId     Int?
  semester       SemesterMaster? @relation(fields: [semesterId], references: [semId], onDelete: SetNull)

  // Fee / payment
  feeType         String         @db.VarChar(50) // "REGISTRATION" or "EXAMINATION"
  feeTypeId       Int?
  feeTypeMaster   FeeTypeMaster? @relation(fields: [feeTypeId], references: [feeTypeId], onDelete: SetNull)
  amountPaid      Float
  paymentStatus   String         @db.VarChar(20) // "PENDING", "SUCCESS", "FAILED"
  paymentDateTime DateTime?

  // Gateway / bank
  merchantOrderId   String? @db.VarChar(100)
  bankRrnNo         String? @db.VarChar(100)
  razorpayOrderId   String? @db.VarChar(100)
  razorpayPaymentId String? @db.VarChar(100)
  razorpaySignature String? @db.VarChar(255)
  gatewayResponse   String? @db.Text

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@index([registrationNo])
  @@index([yearId])
  @@index([semesterId])
  @@index([feeTypeId])
  @@map("studentPayments")
}

model StudentAttachment {
  attachmentId Int     @id @default(autoincrement())
  studentId    Int
  student      Student @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  documentType String  @db.VarChar(50) // E.g., "PHOTO", "SIGNATURE"
  fileUrl      String  @db.VarChar(2000)

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("studentAttachments")
}

model StudentEnrollment {
  enrollmentId   Int               @id @default(autoincrement())
  studentId      Int
  student        Student           @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
