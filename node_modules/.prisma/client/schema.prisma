generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Student {
  StudentRegistrationId Int                     @id @default(autoincrement())
  candidateName         String                  @db.VarChar(255)
  fatherName            String                  @db.VarChar(255)
  email                 String                  @unique @db.VarChar(255)
  mobileNo              String                  @db.VarChar(20)
  registrationNo        String                  @unique @db.VarChar(100)
  CreatedOn             DateTime                @default(now())
  CreatedBy             String                  @db.VarChar(255)
  UpdatedOn             DateTime?               @updatedAt
  UpdatedBy             String?                 @db.VarChar(255)
  IsActive              Boolean                 @default(true)
  IsDeleted             Boolean                 @default(false)
  DeletedRemarks        String?                 @db.VarChar(255)
  DeletedOn             DateTime?
  DeletedBy             String?                 @db.VarChar(255)
  Remarks               String?                 @db.VarChar(255)
  password              String                  @default("") @db.VarChar(255)
  studentProfile        StudentProfile?
  academicDetails       StudentAcademicDetail[]
  studentPayments       StudentPayment[]
  studentAttachments    StudentAttachment[]

  @@map("students")
}

model StateMaster {
  stateId        Int       @id @default(autoincrement())
  stateName      String    @unique @db.VarChar(100)
  stateShortCode String    @unique @db.VarChar(10)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("stateMaster")
}

model CityMaster {
  cityId         Int       @id @default(autoincrement())
  stateId        Int
  cityName       String    @unique @db.VarChar(100)
  cityShortCode  String    @unique @db.VarChar(10)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("cityMaster")
}

model ProgramCategory {
  programCategoryId   Int       @id @default(autoincrement())
  programCategoryName String    @db.VarChar(100)
  pcShortName         String    @db.VarChar(20)
  sequenceNo          Int
  CreatedOn           DateTime  @default(now())
  CreatedBy           String    @db.VarChar(255)
  UpdatedOn           DateTime? @updatedAt
  UpdatedBy           String?   @db.VarChar(255)
  IsActive            Boolean   @default(true)
  IsDeleted           Boolean   @default(false)
  DeletedRemarks      String?   @db.VarChar(255)
  DeletedOn           DateTime?
  DeletedBy           String?   @db.VarChar(255)
  Remarks             String?   @db.VarChar(255)
  programs            Program[]

  @@map("programCategory")
}

model StudentProfile {
  studentProfileId      Int       @id @default(autoincrement())
  studentId             Int       @unique
  student               Student   @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  studentNameHindi      String?   @db.VarChar(255)
  fatherNameHindi       String?   @db.VarChar(255)
  motherName            String?   @db.VarChar(255)
  motherNameHindi       String?   @db.VarChar(255)
  fatherMobileNumber    String?   @db.VarChar(20)
  dateOfBirth           DateTime?
  gender                String?   @db.VarChar(50)
  maritalStatus         String?   @db.VarChar(50)
  religion              String?   @db.VarChar(100)
  nationality           String?   @db.VarChar(100)
  category              String?   @db.VarChar(100)
  subCategory           String?   @db.VarChar(100)
  physicalHandicap      String?   @db.VarChar(255)
  certificateNo         String?   @db.VarChar(255)
  certificateAttachment String?   @db.VarChar(255)
  aadharIdNo            String?   @db.VarChar(50)
  apaarIdNo             String?   @db.VarChar(50)

  // Correspondence Address
  CaddressLine1 String? @db.VarChar(255)
  CaddressLine2 String? @db.VarChar(255)
  CaddressLine3 String? @db.VarChar(255)
  Cstate        String? @db.VarChar(100)
  Ccity         String? @db.VarChar(100)
  Cpincode      String? @db.VarChar(20)

  // Permanent Address
  PaddressLine1 String? @db.VarChar(255)
  PaddressLine2 String? @db.VarChar(255)
  PaddressLine3 String? @db.VarChar(255)
  Pstate        String? @db.VarChar(100)
  Pcity         String? @db.VarChar(100)
  Ppincode      String? @db.VarChar(20)

  // Common Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("studentProfile")
}

model SubjectMaster {
  subjectId        Int                      @id @default(autoincrement())
  subjectName      String                   @db.VarChar(100)
  subjectCode      String                   @db.VarChar(50)
  classType        String                   @db.VarChar(20)
  stream           String?                  @db.VarChar(50) // "SCIENCE", "COMMERCE", "ARTS"
  CreatedOn        DateTime                 @default(now())
  CreatedBy        String                   @db.VarChar(255)
  UpdatedOn        DateTime?                @updatedAt
  UpdatedBy        String?                  @db.VarChar(255)
  IsActive         Boolean                  @default(true)
  IsDeleted        Boolean                  @default(false)
  DeletedRemarks   String?                  @db.VarChar(255)
  DeletedOn        DateTime?
  DeletedBy        String?                  @db.VarChar(255)
  Remarks          String?                  @db.VarChar(255)
  academicSubjects StudentAcademicSubject[]

  @@map("subjectMaster")
}

model Program {
  programId         Int                @id @default(autoincrement())
  programCategoryId Int
  programCategory   ProgramCategory    @relation(fields: [programCategoryId], references: [programCategoryId], onDelete: Cascade)
  programName       String             @db.VarChar(100)
  programShortName  String             @db.VarChar(20)
  programCode       String             @db.VarChar(50)
  durationYears     Int
  termType          String             @db.VarChar(50) // "SEMESTER" or "ANNUAL"
  totalTerms        Int
  sequenceNo        Int
  feeConfigs        ProgramFeeConfig[]

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("programs")
}

model BoardMaster {
  boardId        Int       @id @default(autoincrement())
  boardName      String    @unique @db.VarChar(255)
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  academicDetails StudentAcademicDetail[]

  @@map("boardMaster")
}

model QualificationMaster {
  qualificationId   Int       @id @default(autoincrement())
  qualificationName String    @unique @db.VarChar(100)
  CreatedOn         DateTime  @default(now())
  CreatedBy         String    @db.VarChar(255)
  UpdatedOn         DateTime? @updatedAt
  UpdatedBy         String?   @db.VarChar(255)
  IsActive          Boolean   @default(true)
  IsDeleted         Boolean   @default(false)
  DeletedRemarks    String?   @db.VarChar(255)
  DeletedOn         DateTime?
  DeletedBy         String?   @db.VarChar(255)
  Remarks           String?   @db.VarChar(255)

  academicDetails StudentAcademicDetail[]

  @@map("qualificationMaster")
}

model StudentAcademicDetail {
  academicDetailId Int                      @id @default(autoincrement())
  studentId        Int
  student          Student                  @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  qualificationId  Int
  qualification    QualificationMaster      @relation(fields: [qualificationId], references: [qualificationId])
  boardId          Int
  board            BoardMaster              @relation(fields: [boardId], references: [boardId])
  schoolName       String                   @db.VarChar(255)
  passingYear      Int
  rollNo           String                   @db.VarChar(100)
  resultStatus     String                   @db.VarChar(50)
  marksType        String                   @db.VarChar(20)
  maxMarks         Float
  obtainedMarks    Float
  percentage       Float
  division         String?                  @db.VarChar(50)
  grade            String?                  @db.VarChar(20)
  stream           String?                  @db.VarChar(50) // "SCIENCE", "COMMERCE", "ARTS"
  subjects         StudentAcademicSubject[]
  CreatedOn        DateTime                 @default(now())
  CreatedBy        String                   @db.VarChar(255)
  UpdatedOn        DateTime?                @updatedAt
  UpdatedBy        String?                  @db.VarChar(255)
  IsActive         Boolean                  @default(true)
  IsDeleted        Boolean                  @default(false)
  DeletedRemarks   String?                  @db.VarChar(255)
  DeletedOn        DateTime?
  DeletedBy        String?                  @db.VarChar(255)
  Remarks          String?                  @db.VarChar(255)

  @@map("studentAcademicDetails")
}

model StudentAcademicSubject {
  studentAcademicSubjectId Int                   @id @default(autoincrement())
  academicDetailId         Int
  academicDetail           StudentAcademicDetail @relation(fields: [academicDetailId], references: [academicDetailId], onDelete: Cascade)
  subjectId                Int
  subject                  SubjectMaster         @relation(fields: [subjectId], references: [subjectId])
  maxMarks                 Float
  minMarks                 Float
  obtainedMarks            Float
  grade                    String?               @db.VarChar(20)
  practicalMarks           Float?
  theoryMarks              Float?
  isOptional               Boolean               @default(false)
  CreatedOn                DateTime              @default(now())
  CreatedBy                String                @db.VarChar(255)
  UpdatedOn                DateTime?             @updatedAt
  UpdatedBy                String?               @db.VarChar(255)
  IsActive                 Boolean               @default(true)
  IsDeleted                Boolean               @default(false)
  DeletedRemarks           String?               @db.VarChar(255)
  DeletedOn                DateTime?
  DeletedBy                String?               @db.VarChar(255)
  Remarks                  String?               @db.VarChar(255)

  @@map("studentAcademicSubjects")
}

model AcademicSession {
  sessionId   Int                @id @default(autoincrement())
  sessionName String             @unique @db.VarChar(50)
  feeConfigs  ProgramFeeConfig[]

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("academicSessions")
}

model ProgramFeeConfig {
  feeConfigId Int             @id @default(autoincrement())
  programId   Int
  program     Program         @relation(fields: [programId], references: [programId], onDelete: Cascade)
  sessionId   Int
  session     AcademicSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  registrationBaseFee Float @default(0.0)
  registrationPgRate  Float @default(2.0)
  registrationGstRate Float @default(18.0)
  registrationFinal   Float @default(0.0)

  examinationBaseFee Float @default(0.0)
  examinationPgRate  Float @default(2.0)
  examinationGstRate Float @default(18.0)
  examinationFinal   Float @default(0.0)

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@unique([programId, sessionId])
  @@map("programFeeConfigs")
}

model StudentPayment {
  paymentId     Int     @id @default(autoincrement())
  studentId     Int
  student       Student @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  feeType       String  @db.VarChar(50) // "REGISTRATION" or "EXAMINATION"
  amountPaid    Float
  paymentStatus String  @db.VarChar(20) // "PENDING", "SUCCESS", "FAILED"

  // Razorpay Specific Fields
  razorpayOrderId   String? @db.VarChar(100)
  razorpayPaymentId String? @db.VarChar(100)
  razorpaySignature String? @db.VarChar(255)
  gatewayResponse   String? @db.Text

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("studentPayments")
}

model StudentAttachment {
  attachmentId Int     @id @default(autoincrement())
  studentId    Int
  student      Student @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  documentType String  @db.VarChar(50) // E.g., "PHOTO", "SIGNATURE"
  fileUrl      String  @db.VarChar(2000)

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@map("studentAttachments")
}
