/// College exam roll number (12-digit): CollegeCode + AdmissionYear + ProgramCode + Serial
model StudentRollNumber {
  rollId       Int                @id @default(autoincrement())
  rollNo       String             @unique @db.VarChar(12)
  studentId    Int
  student      Student            @relation(fields: [studentId], references: [StudentRegistrationId], onDelete: Cascade)
  enrollmentId Int?
  enrollment   StudentEnrollment? @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: SetNull)
  sessionId    Int?
  session      AdmissionSession?  @relation(fields: [sessionId], references: [admissionSessionId], onDelete: SetNull)
  programId    Int?
  program      Program?           @relation(fields: [programId], references: [programId], onDelete: SetNull)

  admissionYear String @db.VarChar(4)
  collegeCode   String @db.VarChar(3)
  programCode   String @db.VarChar(2)
  serialNo      String @db.VarChar(3)

  // Common Audit Fields
  CreatedOn      DateTime  @default(now())
  CreatedBy      String    @db.VarChar(255)
  UpdatedOn      DateTime? @updatedAt
  UpdatedBy      String?   @db.VarChar(255)
  IsActive       Boolean   @default(true)
  IsDeleted      Boolean   @default(false)
  DeletedRemarks String?   @db.VarChar(255)
  DeletedOn      DateTime?
  DeletedBy      String?   @db.VarChar(255)
  Remarks        String?   @db.VarChar(255)

  @@unique([studentId, admissionYear])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([sessionId])
  @@index([programId])
  @@index([admissionYear])
  @@map("studentRollNumber")
}
