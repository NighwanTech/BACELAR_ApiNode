# ===== UniversityOS Environment Configuration =====
# Copy to .env and adjust for your environment

# --- Server ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
HOST=0.0.0.0

# --- Database (MySQL) ---
DATABASE_URL="mysql://u963801592_bacelar_User:Bacelar%40123@srv1100.hstgr.io:3306/u963801592_bacelar_Dev"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://universityos:universityos@localhost:5672
RABBITMQ_EXCHANGE=universityos.events

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_token_secret
JWT_REFRESH_SECRET=change_me_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=universityos
JWT_AUDIENCE=universityos-clients

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=universityos
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=universityos-documents

# --- OpenSearch ---
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change_me_admin

# --- BCrypt ---
BCRYPT_SALT_ROUNDS=10

# --- Tenant ---
DEFAULT_TENANT_ID=default-tenant
